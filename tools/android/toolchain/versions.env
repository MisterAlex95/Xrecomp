# The on-device toolchain (XBA embedded Prepare, phase 1): pinned versions and source checksums.
# Sourced by the build scripts next to this file; tools/docker/android.Dockerfile and docs/android/toolchain.md
# name the same versions (change all three together).

# Android target: the app's minSdk (decision XBA-10). The NDK is the image's ($ANDROID_NDK_HOME, r28c).
XBA_TC_API=30
XBA_TC_TRIPLE=aarch64-linux-android

# CPython with its official Android build (Android/android.py, PEP 738).
PYTHON_VERSION=3.13.18
PYTHON_SHA256=abb0102e6d4ae027509bcb82327d9dd85515b44a3ba8ad538cfc5e9847029f68
PYTHON_URL=https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz
# Prebuilt dependencies android.py unpacks (BeeWare's cpython-android-source-deps, the ones CPython's own
# Android release uses), pre-fetched here so their checksums are checked: name-version, sha256 for aarch64.
PYTHON_DEPS_URL=https://github.com/beeware/cpython-android-source-deps/releases/download
PYTHON_DEPS="
bzip2-1.0.8-3   2385f46e173d525f079946957c007000a8ad11d8496ba66bae99129183d74bd9
libffi-3.4.4-3  9f2c0255ce025c177d44db16174ad5158c7560efe3c7ef0c8c0c64b2196e6a9d
openssl-3.5.9-0 bf115f29963d577e20a1595dac13baec7ccd559bf8a05f37659ba6b735a8778b
sqlite-3.53.4-0 11dfa2e8360b3022fb5da98743273bee09559cb546bbd00398e1578fefb3b3db
xz-5.4.6-1      320b76d45dc3499cf855e5310f875cba61c2608e4a98bb280cc4f1b8f189da1a
"

# Capstone (the disassembler of tools/disasm, tools/recomp): the library (X86 only) and its ctypes bindings.
CAPSTONE_VERSION=5.0.9
CAPSTONE_SHA256=1b70351879f6998998ebcbe09bd5f3c5e27127e985af14722cbe52c11c35178e
CAPSTONE_URL=https://github.com/capstone-engine/capstone/releases/download/${CAPSTONE_VERSION}/capstone-${CAPSTONE_VERSION}.tar.xz

# LLVM: clang + lld as one multicall binary. 19.1.x, the release line of the NDK r28c clang (19.0.1).
LLVM_VERSION=19.1.7
LLVM_SHA256=82401fea7b79d0078043f7598b835284d6650a75b93e64b6f761ea7b63097501
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/llvm-project-${LLVM_VERSION}.src.tar.xz
