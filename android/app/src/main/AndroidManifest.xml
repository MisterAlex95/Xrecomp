<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- All files access (XBA-54): read the picked game folder in place with POSIX calls. Asked from the picker with
         the settings screen, never required: without it the folder is copied into the app's storage. Personal
         builds only (refused on the Play Store). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- The on-device Prepare (docs/android/prepare.md): a foreground service of type specialUse with a partial wake
         lock; POST_NOTIFICATIONS is asked at the first Prepare on Android 13+ (the progress notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- « Create an app » (Manage; docs/android/app-shell.md « A game's own app »): the generated APK goes to Android's
         installer, which asks the player to confirm. Allowed per app by the player (« Install unknown apps »). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Vulkan drivers (docs/android/app-shell.md « Vulkan drivers », VkDriverIndex): the list of Turnip drivers from
         the GitHub Releases API and the download the player picks, only from the Drivers screen. No driver ships in
         the app. XRecomp only: TitleApk drops this permission from a game's own app (PARENT_ONLY_PERMISSIONS). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The pack handover (XBA-176, docs/android/prepare.md « Handing a pack to a game's own app »): a game's own app
         looks for XRecomp. TitleApk leaves this <package> as it is, so in the copy it names the parent. -->
    <queries>
        <package android:name="${applicationId}" />
    </queries>

    <!-- allowNativeHeapPointerTagging: lifted code may squeeze host pointers; tagged heap pointers would break it
         (see the Plane page « Reference · BananaNative »). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:allowNativeHeapPointerTagging="false"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- The launcher (XBA-41, with the game picker of XBA-54): the launcher entry, in its own process so that it
             never loads SDL or the runtime (and can end and restart the game's process after a new choice). With a
             valid game and « Open the game directly next time » on, it starts ShellActivity at once. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:process=":launcher"
            android:theme="@style/Launcher"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="fr.adserver.xrecomp.CHOOSE_GAME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="fr.adserver.xrecomp.SHOW_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A game's pinned home-screen shortcut (TitleShortcut): its intent is explicit, the filter documents it. -->
            <intent-filter>
                <action android:name="fr.adserver.xrecomp.PLAY_TITLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShellActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
        </activity>

        <!-- The on-device Prepare (docs/android/prepare.md): python -m tools.prepare and clang, in their own process
             so that neither the launcher nor the game shares their memory. specialUse: dataSync is capped at 6 h a
             day on Android 15, and a Prepare compiles locally (no transfer). -->
        <service
            android:name=".PrepareService"
            android:exported="false"
            android:process=":prepare"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compiles the user's own game files into native code on the device (a one-time, user-started build of 20 to 60 minutes, with progress and Cancel in the notification)" />
        </service>

        <!-- « Check my library » (XBA-130): its screen and the service that drives it, in the launcher's process; the
             service keeps that process alive while a checked game runs in front of it. -->
        <activity
            android:name=".CheckActivity"
            android:exported="false"
            android:process=":launcher"
            android:launchMode="singleTask"
            android:theme="@style/Launcher"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <service
            android:name=".CheckService"
            android:exported="false"
            android:process=":launcher"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Checks the user's own games one after the other on the device, at the user's request (prepares each, starts it for three minutes, writes a compatibility report), with progress and Stop in the notification" />
        </service>

        <!-- « Create an app »: the installer's status (confirmation, then installed / cancelled / failed), from this
             app's own PendingIntent only. -->
        <receiver
            android:name=".TitleAppReceiver"
            android:exported="false"
            android:process=":launcher" />

        <!-- « Share log » on the launcher: the Prepare's log, read-only, by a temporary grant. -->
        <provider
            android:name=".LogProvider"
            android:authorities="${applicationId}.logs"
            android:process=":launcher"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The pack handover (XBA-176): a game's own app asks for its pack through this activity, for a result; it
             checks the caller (package fr.adserver.xrecomp.t<tid>, signed by the game apps' key), grants read
             access to the pack's files through PackProvider, and finishes without showing anything. -->
        <activity
            android:name=".PackHandoverActivity"
            android:exported="true"
            android:process=":launcher"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="fr.adserver.xrecomp.PACK_HANDOVER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Read-only, never exported: only URIs PackHandoverActivity granted are readable by another app. -->
        <provider
            android:name=".PackProvider"
            android:authorities="${applicationId}.packs"
            android:process=":launcher"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
