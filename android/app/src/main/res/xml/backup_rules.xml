<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are off (allowBackup="false"); these rules also keep the frame generation shader cache (files/lsfg:
     shaders taken from the player's own Lossless.dll, docs/technical/framegen.md) and the custom Vulkan drivers
     (files/vk_drivers: third-party native code, VkDrivers.java) out of any backup on Android 11. -->
<full-backup-content>
    <exclude domain="file" path="lsfg/" />
    <exclude domain="file" path="vk_drivers/" />
</full-backup-content>
