<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" stops cloud backups but not a device-to-device transfer. The frame generation
     shader cache (files/lsfg: shaders taken from the player's own Lossless.dll, docs/technical/framegen.md) and the
     custom Vulkan drivers (files/vk_drivers, VkDrivers.java) never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="lsfg/" />
        <exclude domain="file" path="vk_drivers/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="lsfg/" />
        <exclude domain="file" path="vk_drivers/" />
    </device-transfer>
</data-extraction-rules>
