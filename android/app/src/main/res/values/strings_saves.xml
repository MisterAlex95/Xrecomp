<!-- Saves out and back, and cloud saves (docs/android/app-shell.md « Saves out and back », « Cloud saves »). A file of
     its own so that it does not collide with other strings edits. -->
<resources>
    <string name="SAVES_EXPORT">Export saves</string>
    <string name="SAVES_EXPORT_ALL">Export all saves</string>
    <string name="SAVES_EXPORT_DETAIL">Writes your saves to a zip file you choose: a folder, a USB stick or a cloud drive such as Google Drive. Import it here or on another device.</string>
    <string name="SAVES_IMPORT">Import saves</string>
    <string name="SAVES_IMPORT_DETAIL">Restores saves from a zip file made by Export saves. Each game in the file gets its saves back; the ones it had are kept aside. A running game of these saves is closed first.</string>
