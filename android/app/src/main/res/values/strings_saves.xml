        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>
    <string name="SAVES_NONE">No saves to export yet.</string>
    <string name="SAVES_EXPORTING">Exporting saves</string>
    <string name="SAVES_IMPORTING">Importing saves</string>
    <plurals name="SAVES_EXPORTED">
        <item quantity="one">Saves of %1$d game written to %2$s.</item>
        <item quantity="other">Saves of %1$d games written to %2$s.</item>
    </plurals>
    <plurals name="SAVES_IMPORTED">
        <item quantity="one">Saves of %d game restored.</item>
        <item quantity="other">Saves of %d games restored.</item>
    </plurals>
    <string name="SAVES_NOT_AN_ARCHIVE">%s is not a save file made by XRecomp.</string>
